# ВТБ Ко-пилот: Конфигурация окружения (Спринт №1 MVP)
# Соответствие 152-ФЗ: архитектура поддерживает подключение изолированных On-Prem контуров (vLLM / Ollama)
# и корпоративных шлюзов (GigaChat API). Для Спринта №1 используется baseline-адаптер.

# API-ключ шлюза языковых моделей (LLM Gateway)
LLM_API_KEY=your_api_key_here
# Обратная совместимость для плавного перехода
GEMINI_API_KEY=

# Идентификатор модели (Baseline Спринта №1 / On-Prem vLLM в Спринте №2)
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Таймаут запросов к провайдеру (строго от 1s до 30s)
LLM_TIMEOUT=25s
GEMINI_TIMEOUT=25s

# Порт веб-приложения для Docker Compose
APP_PORT=8080
